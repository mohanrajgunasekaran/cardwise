# CardWise Environment Configuration Example
PROJECT_NAME="CardWise API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production: Set a cryptographically random secret key (e.g. openssl rand -hex 32)
SECRET_KEY="replace-with-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development SQLite: sqlite:///./cardwise.db
# Production PostgreSQL: postgresql://user:password@localhost:5432/cardwise_db
DATABASE_URL="sqlite:///./cardwise.db"
